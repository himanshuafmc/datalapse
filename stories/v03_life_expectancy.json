0.0,"dur":4.0},{"hold":3.0},{"to":1998.0,"dur":9.0},{"hold":1.5},{"to":2019.0,"dur":7.0},{"to":2021.0,"dur":2.0},{"hold":2.5},{"to":2023.0,"dur":2.0},{"hold":4.0}]},"series":["India","China","Japan","UK","USA","Nigeria","Brazil"],"title":"Life Expectancy at Birth","subtitle":"Average years a newborn could expect to live","source":"Source: Gapminder Life Expectancy v15 (UN, IHME and historical estimates).","valueFormat":{"type":"fixed","digits":0},"yTickFormat":{"type":"fixed","digits":0},"yRange":[0,90],"log":false,"xRange":[1800,2023],"highlight":"India","markers":[{"x":1918,"label":"Flu pandemic"},{"x":1947,"label":"Independence"},{"x":2020,"label":"COVID-19"}],"captions":[{"year":1800,"dur":5.0,"kicker":"1800","chapter":"Life expectancy, 1800–2023","text":"Life expectancy at birth: 25 years in India, about 39 in the UK. Most of the gap is children who never grew up."},{"year":1870,"dur":4.5,"kicker":"1800s","text":"The UK and USA pull ahead first, thanks to clean water, sewers and vaccination."},{"year":1918,"dur":5.5,"kicker":"1918 · Flu pandemic","chapter":"1918: the flu pandemic","text":"One of the deadliest years in India's history: life expectancy crashes to 9 years."},{"year":1945,"dur":4.5,"kicker":"1945","text":"War: Japan's life expectancy falls to 30. By 1968 it has overtaken the UK and USA."},{"year":1960,"dur":5.0,"kicker":"1959–61 · China","chapter":"Famine, then the long climb","text":"China's Great Famine: life expectancy plunges to 26, then rebounds fast."},{"year":1980,"dur":4.5,"kicker":"The long climb","text":"Antibiotics, vaccines, oral rehydration and better food lift every line."},{"year":1998,"dur":4.5,"kicker":"Nigeria","text":"Nigeria's line barely moves for two decades: 50 years in 1980, 53 in 2000."},{"year":2020,"dur":4.5,"kicker":"2020–21 · COVID-19","text":"The pandemic erases years of progress: India loses 2.1 years between 2019 and 2021."},{"year":2023,"dur":5.0,"kicker":"2023","text":"India: 25 to 72 years. Almost three times as long as in 1800."}],"display":{},"colors":{},"lw":3.0,"xMode":"fixed","minSpan":20,"chapter":null},{"type":"dotGrid","data":"s3","column":"value","pace":{"start":1900.0,"lead":0.5,"steps":[{"hold":3.5},{"to":1950.0,"dur":8.0},{"hold":2.5},{"to":2000.0,"dur":7.0},{"to":2023.0,"dur":5.0},{"hold":5.0}]},"title":"100 Children Born in India","subtitle":"Red: did not survive to their 5th birthday","source":"Source: Gapminder Child Mortality v12 (UN IGME and historical estimates).","bigFormat":{"type":"fixed","digits":0,"suffix":" in 100"},"smallText":"children did not live to see their fifth birthday","captions":[{"year":1900,"dur":5.5,"kicker":"1900","text":"More than half of all children in India die before age 5 (54 in 100)."},{"year":1950,"dur":5.0,"kicker":"1950","text":"Still 28 in 100. The biggest gains are about to come."},{"year":2023,"dur":6.0,"kicker":"Today","text":"About 3 in 100. In Japan it is 0.2. The next jump is still possible."}],"badColor":null,"goodColor":null,"chapter":"100 children"},{"type":"statCards","heading":"Two centuries of progress","cards":[{"big":"25 to 72","small":"India's life expectancy, 1800 vs 2023","color":"#FF9933"},{"big":"54 to 3","small":"Indian children in 100 who died before age 5, 1900 vs 2023","color":"#FF4D5E"},{"big":"84","small":"Japan's life expectancy, the highest here","color":"#FF5DA2"}],"duration":8.0,"chapter":"Recap","footer":"Life expectancy at birth is pulled down mostly by deaths in childhood."},{"type":"outro","question":"Which health statistic should we chart next?","sources":"Gapminder Life Expectancy v15 and Child Mortality v12","duration":6.5,"chapter":"Your turn"}]}